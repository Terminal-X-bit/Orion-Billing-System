[TEMPLATE]
[TEMPLATE]
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Dashboard: live guest portal (served by the MikroTik bridge) ---
# Used by Settings -> Captive Portal Branding (QR code + "Open live portal").
# Set to the bridge's address as guests reach it, e.g. http://192.168.88.10:8787/portal
# Operators can also override this at runtime in the preview's QR panel.
# VITE_PORTAL_URL=http://192.168.88.10:8787/portal

# --- MikroTik bridge (mikrotik-bridge/.env; service-side only) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MIKROTIK_API_USER=orion-bridge
# MIKROTIK_API_PASSWORD=change-me
# BRIDGE_API_KEY=change-me
# BRIDGE_DEFAULT_ROUTER_ID=
