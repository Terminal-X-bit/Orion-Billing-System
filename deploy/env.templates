# Template for the compose deployment's env files.
# Copy each section into its own file before `docker compose up`:
#   cp deploy/env.templates bridge.env && cp deploy/env.templates dashboard.env
#   (then keep only the relevant section in each and fill in real values)
# These files are git-ignored (see .gitignore) — never commit real keys.

# =============================================================================
# bridge.env — consumed by the bridge container (see mikrotik-bridge/Dockerfile)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BRIDGE_API_KEY=generate-a-long-random-hex
BRIDGE_POLL_INTERVAL_MS=30000
BRIDGE_PORT=8787
BRIDGE_DEFAULT_ROUTER_ID=
MIKROTIK_API_USER=orion-bridge
MIKROTIK_API_PASSWORD=change-me
# M-Pesa (Daraja) — optional; leave empty to run the bridge without payment flows
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# =============================================================================
# dashboard.env — build args baked into the SPA bundle (see Dockerfile)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Portal URL guests/operator dashboard use to reach the portal; if unset the
# dashboard falls back to the current hostname + bridge port 8787. Required
# only when guests reach the portal on a different host than the dashboard.
# VITE_PORTAL_URL=http://192.168.88.10:8787/portal
