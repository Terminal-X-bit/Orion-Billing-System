# MikroTik <-> Orion bridge configuration
# Copy to mikrotik-bridge/.env (or export in your process manager).

# Supabase project with SERVICE ROLE key (server-side only! never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the dashboard/API must send as the x-bridge-key header.
# If unset, a random key is generated and printed at startup.
BRIDGE_API_KEY=change-me

# Poll interval for voucher/package/STK sync (ms)
BRIDGE_POLL_INTERVAL_MS=30000

# HTTP API port
BRIDGE_PORT=8787

# RouterOS API credentials applied to every router row in the routers table.
# (The routers table stores host/port per device; the username/password live here.)
MIKROTIK_API_USER=orion-bridge
MIKROTIK_API_PASSWORD=change-me

# Router used for package profiles / voucher users when not specified per-call
BRIDGE_DEFAULT_ROUTER_ID=

# --- Safaricom Daraja (M-Pesa STK Push) ---
# From https://developer.safaricom.co.ke (app credentials)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill/till shortcode and the Lipa na M-Pesa Online passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=
# sandbox | production
MPESA_ENVIRONMENT=sandbox
# Publicly reachable base URL of this bridge; Daraja POSTs outcomes to
# <MPESA_CALLBACK_URL>/mpesa/callback (must be HTTPS in production).
MPESA_CALLBACK_URL=
